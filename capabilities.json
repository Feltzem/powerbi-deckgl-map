{
  "dataRoles": [
    {
      "displayName": "Geometry ID",
      "name": "geometryId",
      "kind": "Grouping",
      "description": "A unique identifier for each geometry"
    },
    {
      "displayName": "Layer Type",
      "name": "layerType",
      "kind": "Measure",
      "description": "The type of geometry - by default, the string 'scatter', 'line' (A->B), 'arc' (A-> B), 'path' (A->B->C ...) or 'polygon'"
    },
    {
      "displayName": "Point1 Latitude",
      "name": "point1Latitude",
      "kind": "Measure",
      "description": "Scatter: this is the latitude of the point. Lines/arcs: this is the latitude of the starting point"
    },
    {
      "displayName": "Point1 Longitude",
      "name": "point1Longitude",
      "kind": "Measure",
      "description": "Scatter: this is the longitude of the point. Lines/arcs: this is the longitude of the starting point"
    },
    {
      "displayName": "Point2 Latitude",
      "name": "point2Latitude",
      "kind": "Measure",
      "description": "Lines/arcs: this is the latitude of the ending point"
    },
    {
      "displayName": "Point2 Longitude",
      "name": "point2Longitude",
      "kind": "Measure",
      "description": "Lines/arcs: this is the longitude of the ending point"
    },
    {
      "displayName": "Well Known Text",
      "name": "wkt",
      "kind": "Measure",
      "description": "Geometry in WKT format. (If using line/arc you must use Point1/Point2.)"
    },
    {
      "displayName": "Well Known Polyline",
      "name": "wkp",
      "kind": "Measure",
      "description": "Geometry in WKP format. (If using line/arc you must use Point1/Point2.)"
    },
    {
      "displayName": "Scatter radius (m)",
      "name": "scatterRadius",
      "kind": "Measure",
      "description": "The radius of scatter in meters"
    },
    {
      "displayName": "Scatter elevation (m)",
      "name": "scatterElevation",
      "kind": "Measure",
      "description": "Optional per-row height for scatter points, in meters",
      "preferredTypes": [
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Heatmap weight",
      "name": "heatmapWeight",
      "kind": "Measure",
      "description": "Optional numeric weight used when rendering scatter points as a heatmap",
      "preferredTypes": [
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Scatter line width (m)",
      "name": "scatterLineWidth",
      "kind": "Measure",
      "description": "The width of scatter's lines in meters"
    },
    {
      "displayName": "Scatter line color",
      "name": "scatterLineColor",
      "kind": "GroupingOrMeasure",
      "description": "The color of the scatter's lines. Accepts `#RGB`, `#RRGGBB`, `#RRGGBBAA`, `rgb(...)`, or `rgba(...)` direct colors, numeric values for the scatter line gradient settings, or categorical text values for the scatter line categorical palette",
      "preferredTypes": [
        {
          "text": true
        },
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Scatter fill",
      "name": "scatterFillColor",
      "kind": "GroupingOrMeasure",
      "description": "The fill color of the scatter. Accepts `#RGB`, `#RRGGBB`, `#RRGGBBAA`, `rgb(...)`, or `rgba(...)` direct colors, numeric values for the scatter fill gradient settings, or categorical text values for the scatter fill categorical palette",
      "preferredTypes": [
        {
          "text": true
        },
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "(Line) line width (m)",
      "name": "lineLineWidth",
      "kind": "Measure",
      "description": "The width of line's lines in meters."
    },
    {
      "displayName": "(Line) line color",
      "name": "lineLineColor",
      "kind": "GroupingOrMeasure",
      "description": "The color of the line. Accepts `#RGB`, `#RRGGBB`, `#RRGGBBAA`, `rgb(...)`, or `rgba(...)` direct colors, numeric values for the line gradient settings, or categorical text values for the line categorical palette",
      "preferredTypes": [
        {
          "text": true
        },
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Path width (m)",
      "name": "pathWidth",
      "kind": "Measure",
      "description": "The width of path's lines in meters"
    },
    {
      "displayName": "Path color",
      "name": "pathColor",
      "kind": "GroupingOrMeasure",
      "description": "The color of the path. Accepts `#RGB`, `#RRGGBB`, `#RRGGBBAA`, `rgb(...)`, or `rgba(...)` direct colors, numeric values for the path gradient settings, or categorical text values for the path categorical palette",
      "preferredTypes": [
        {
          "text": true
        },
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Polygon line width (m)",
      "name": "polygonLineWidth",
      "kind": "Measure",
      "description": "The width of polygon's lines in meters"
    },
    {
      "displayName": "Polygon line color",
      "name": "polygonLineColor",
      "kind": "GroupingOrMeasure",
      "description": "The line color of the polygon. Accepts `#RGB`, `#RRGGBB`, `#RRGGBBAA`, `rgb(...)`, or `rgba(...)` direct colors, numeric values for the polygon line gradient settings, or categorical text values for the polygon line categorical palette",
      "preferredTypes": [
        {
          "text": true
        },
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Polygon fill",
      "name": "polygonFillColor",
      "kind": "GroupingOrMeasure",
      "description": "The fill color of the polygon. Accepts `#RGB`, `#RRGGBB`, `#RRGGBBAA`, `rgb(...)`, or `rgba(...)` direct colors, numeric values for the polygon fill gradient settings, or categorical text values for the polygon fill categorical palette",
      "preferredTypes": [
        {
          "text": true
        },
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Polygon extrude elevation (meters)",
      "name": "polygonExtrudeElevation",
      "kind": "Measure",
      "description": "Height to extrude the polygon, in meters",
      "preferredTypes": [
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Arc line width (m)",
      "name": "arcLineWidth",
      "kind": "Measure",
      "description": "The width of arc's lines in meters"
    },
    {
      "displayName": "Arc Source color",
      "name": "arcSourceColor",
      "kind": "GroupingOrMeasure",
      "description": "The color of the arc's source. Accepts `#RGB`, `#RRGGBB`, `#RRGGBBAA`, `rgb(...)`, or `rgba(...)` direct colors, numeric values for the arc source gradient settings, or categorical text values for the arc source categorical palette",
      "preferredTypes": [
        {
          "text": true
        },
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Arc Target color",
      "name": "arcTargetColor",
      "kind": "GroupingOrMeasure",
      "description": "The color of the arc's target. Accepts `#RGB`, `#RRGGBB`, `#RRGGBBAA`, `rgb(...)`, or `rgba(...)` direct colors, numeric values for the arc target gradient settings, or categorical text values for the arc target categorical palette",
      "preferredTypes": [
        {
          "text": true
        },
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Tooltip HTML",
      "name": "tooltipHtml",
      "kind": "Measure",
      "description": "The HTML to display in the tooltip. You can use CSS = )"
    },
    {
      "displayName": "Timestamp",
      "name": "timestamp",
      "kind": "GroupingOrMeasure",
      "description": "Per-row time used to drive the animation and the time-as-height encoding. Accepts a datetime or a numeric value in seconds. When bound, the Animation card controls the trailing-window playback.",
      "preferredTypes": [
        {
          "numeric": true
        }
      ]
    }
  ],
