  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "for": {
            "in": "geometryId"
          },
          "dataReductionAlgorithm": {
            "window": {
              "count": 10000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "layerType"
              }
            },
            {
              "bind": {
                "to": "point1Latitude"
              }
            },
