{
  "name": "visual",
  "description": "powerbi-deckgl-map",
  "version": "1.6.2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Feltzem/powerbi-deckgl-map"
  },
  "license": "MIT",
  "scripts": {
    "pbiviz": "pbiviz",
    "generate:wkp-wasm": "node scripts/generate-wkp-wasm.cjs",
    "postinstall": "npm run generate:wkp-wasm",
    "prestart": "npm run generate:wkp-wasm",
    "prepackage": "npm run generate:wkp-wasm",
    "start": "pbiviz start",
    "package": "pbiviz package",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.eslint.json --noEmit",
    "test": "node scripts/run-tests.cjs",
    "check:version": "node scripts/check-version.cjs",
    "check": "npm run lint && npm run typecheck && npm run typecheck:all && npm test && npm run check:version",
    "bench": "node --expose-gc --import tsx scripts/benchmarks/run.ts",
    "bench:current": "node --expose-gc --import tsx scripts/benchmarks/run.ts --label working-tree",
    "bench:compare": "node --expose-gc --import tsx scripts/benchmarks/compare.ts"
  },
  "dependencies": {
    "@loaders.gl/core": "^4.3.4",
    "@loaders.gl/wkt": "^4.3.4",
    "@wkpjs/web": "0.4.0",
    "deck.gl": "^9.1.14",
    "maplibre-gl": "^5.7.1",
    "powerbi-visuals-api": "~5.3.0",
    "powerbi-visuals-utils-formattingmodel": "^6.2.1",
    "process": "^0.11.10"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-plugin-powerbi-visuals": "^1.0.0",
    "powerbi-visuals-tools": "^7.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "fast-xml-parser": ">=5.3.4",
    "powerbi-visuals-utils-formattingmodel": {
      "powerbi-visuals-api": "$powerbi-visuals-api"
    }
  }
}
